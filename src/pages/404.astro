---
import Terminal from '../layouts/Terminal.astro';
const sections = ['projects', 'blog', 'reading', 'contact'];
---
<Terminal title="404 · command not found" description="Page not found." path="/404" noindex homeLinks>
  <section>
    <p class="prompt"><span class="ps1">itzik@program-il<span class="path">:~</span>$</span><span class="ps1-short">$</span>{' '}<span class="cmd" id="typed">cd ???</span></p>
    <p class="notfound">zsh: command not found: <span id="missing">this page</span></p>
    <p class="comment">try one of these instead</p>
    <ul class="list">
      <li><a href="/about/">about</a></li>
      {sections.map((s) => <li><a href={`/#${s}`}>{s}</a></li>)}
    </ul>
  </section>
  <script>
    const name = location.pathname.replace(/^\/+|\/+$/g, '') || '/';
    document.getElementById('missing')!.textContent = name;
    document.getElementById('typed')!.textContent = name;
  </script>
</Terminal>
