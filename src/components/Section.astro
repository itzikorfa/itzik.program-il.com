---
interface Props { id: string; cmd: string }
const { id, cmd } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-cmd`}>
  <p class="prompt" id={`${id}-cmd`}>
    <span class="ps1">itzik@program-il<span class="path">:~</span>$</span><span class="ps1-short">$</span>{' '}<span class="cmd">{cmd}</span>
  </p>
  <slot />
</section>
