---
// Typed console (progressive enhancement): hidden until src/scripts/console.ts starts it.
import { getPublishedPosts, isoDate } from '../lib/posts';
import { profile } from '../data/profile';
import { jsonLdString } from '../lib/jsonld';

const posts = (await getPublishedPosts()).map((p) => ({ slug: p.id, title: p.data.title, date: isoDate(p.data.date) }));
const data = {
  posts,
  profile: { name: profile.name, title: profile.title, tagline: profile.tagline, location: profile.location },
  links: { linkedin: profile.links.linkedin, github: profile.links.github, email: profile.links.email },
};
const chips = ['help', 'whoami', 'ls blog/', 'projects', 'favorites', 'contact'];
---
<div class="console" data-console hidden>
  <button type="button" class="console-toggle" aria-expanded="false" aria-controls="console-body" aria-label="Open the console">
    <span><span class="console-p">$</span> console <span class="console-hint">· type help · Tab completes · ↑ ↓ history</span><span class="console-hint-phone">· tap to type a command</span></span>
    <span class="console-chevron" aria-hidden="true"></span>
  </button>
  <div class="console-body" id="console-body">
    <div class="console-out" role="log" aria-label="Console output" aria-live="polite"></div>
    <div class="console-chips" role="group" aria-label="Quick commands">
      {chips.map((c) => <button type="button" data-cmd={c}>{c}</button>)}
    </div>
    <form class="console-form" autocomplete="off">
      <span class="console-ps1" aria-hidden="true"><span class="ps1">itzik@program-il<span class="path">:~</span>$</span><span class="ps1-short">$</span>&nbsp;</span>
      <input type="text" name="cmd" aria-label="Type a command" placeholder="type a command, e.g. help"
        autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" maxlength="500" />
    </form>
  </div>
  <script type="application/json" id="console-data" set:html={jsonLdString(data)} />
</div>
<script>
  import { initConsole } from '../scripts/console';
  initConsole();
</script>
